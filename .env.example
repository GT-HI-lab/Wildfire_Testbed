AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Generate separate random values with: openssl rand -hex 32
STUDY_ACCESS_SECRET=replace-with-random-64-character-secret
STUDY_ADMIN_KEY=replace-with-a-different-random-64-character-secret

# Enter the four Prolific study IDs and completion codes after creating every wave.
PROLIFIC_STUDY_IDS={"1":"WAVE_1_STUDY_ID","2":"WAVE_2_STUDY_ID","3":"WAVE_3_STUDY_ID","4":"WAVE_4_STUDY_ID"}
PROLIFIC_COMPLETION_CODES={"1":"WAVE1CODE","2":"WAVE2CODE","3":"WAVE3CODE","4":"WAVE4CODE"}

# Recommended when Secure External URL is unavailable. Keep this server-side only.
PROLIFIC_API_TOKEN=replace-with-prolific-api-token

# Set true only if Secure External URL is enabled for all four Prolific waves.
PROLIFIC_REQUIRE_SECURE_URL=false

# Never enable this on the production study deployment.
PROLIFIC_TEST_MODE=false

# Optional but recommended analysis warehouse. Run supabase/analytics-schema.sql
# first, then use the server-side Secret key (sb_secret_...), never a publishable key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-secret
